{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/rpb-manifest-0.1.schema.json",
  "title": "Replication Pack Builder Manifest Schema v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "created_utc",
    "producer",
    "subject",
    "claims",
    "environment",
    "commands",
    "artifacts",
    "evidence",
    "policy",
    "signing"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rpb-manifest-0.1"
    },
    "pack_id": {
      "type": "string",
      "description": "UUID for the pack (UUIDv4/UUIDv7 acceptable).",
      "minLength": 8
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "const": "rpb" },
        "version": { "type": "string", "minLength": 3 },
        "build": { "type": "string" },
        "host_fingerprint": {
          "type": "string",
          "description": "Optional: hash of host info to aid debugging without leaking details."
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "vcs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["git", "none"] },
            "repo_url": { "type": "string" },
            "commit": { "type": "string" },
            "dirty": { "type": "boolean" }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "profile", "label", "properties"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 5 },
          "profile": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "label": { "type": "string", "minLength": 1 },
          "properties": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "description": "Property IDs that map to files under /SPEC/."
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "image_digest", "os_arch"],
      "properties": {
        "type": { "type": "string", "const": "container" },
        "image_digest": {
          "type": "string",
          "description": "Immutable digest for the build/verify container.",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "os_arch": {
          "type": "string",
          "examples": ["linux/amd64", "linux/arm64"]
        },
        "toolchain": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "proofs", "build"],
      "properties": {
        "build": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional build commands (may be empty)."
        },
        "tests": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Test commands. Required for P2.",
          "minItems": 0
        },
        "proofs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Proof-check commands. Required for P3 (MathSafe) if enabled.",
          "minItems": 0
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes", "kind"],
        "properties": {
          "path": {
            "type": "string",
            "description": "POSIX-style path inside the pack.",
            "pattern": "^[^\\\\]*$"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "kind": {
            "type": "string",
            "enum": [
              "spec",
              "source",
              "binary",
              "log",
              "test_result",
              "proof_result",
              "policy",
              "manifest",
              "hashlist",
              "signature",
              "other"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "type",
          "command",
          "exit_code",
          "stdout_path",
          "stderr_path",
          "outputs",
          "started_utc",
          "ended_utc"
        ],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 5 },
          "type": { "type": "string", "enum": ["build", "tests", "proofs"] },
          "command": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer", "minimum": 0 },
          "stdout_path": { "type": "string" },
          "stderr_path": { "type": "string" },
          "outputs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "started_utc": { "type": "string", "format": "date-time" },
          "ended_utc": { "type": "string", "format": "date-time" }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "policy_sha256"],
      "properties": {
        "policy_id": { "type": "string", "minLength": 1 },
        "policy_version": { "type": "string", "minLength": 1 },
        "policy_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_digest_sha256", "signers"],
      "properties": {
        "root_digest_sha256": {
          "type": "string",
          "description": "SHA-256 over canonical MANIFEST.json + HASHES.json + POLICY.json.",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "redactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "reason"],
        "properties": {
          "pattern": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}